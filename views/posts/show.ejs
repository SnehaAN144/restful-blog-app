<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= post.title %> — BlogApp
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include("../partials/header") %>

        <div class="post-card fade-up">

            <a href="/posts" class="read-more-chip mb-3 d-inline-block">← Back to all posts</a>

            <div class="section-divider"></div>

            <h1>
                <%= post.title %>
            </h1>

            <div class="post-meta">
                ✍ &nbsp;<%= post.username %>
            </div>

            <p>
                <%= post.content %>
            </p>

            <div class="section-divider"></div>

            <div class="post-actions">
                <a href="/posts/edit/<%= post.id %>" class="btn btn-warning">✏ Edit</a>

                <form action="/posts/delete/<%= post.id %>" method="POST" style="display:inline;">
                    <button type="submit" class="btn btn-danger" onclick="return confirm('Delete this post?')">🗑
                        Delete</button>
                </form>

                <a href="/posts" class="btn btn-outline">All Posts</a>
            </div>

        </div>

        <%- include("../partials/footer") %>

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>