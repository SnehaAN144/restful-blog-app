<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>New Post — BlogApp</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<%- include("../partials/header") %>

<div class="fade-up mb-3">
  <h1 class="page-heading">New Post</h1>
  <p class="page-subheading">Share something worth reading</p>
</div>

<div class="form-card fade-up fade-up-1">

  <form action="/posts/create" method="POST">

    <div class="mb-3">
      <label class="form-label">Title</label>
      <input type="text" name="title" placeholder="Your headline here…" class="form-control" required>
    </div>

    <div class="mb-4">
      <label class="form-label">Content</label>
      <textarea name="content" rows="10" placeholder="Write your story…" class="form-control" required></textarea>
    </div>

    <div class="d-flex gap-2">
      <button type="submit" class="btn btn-primary">Publish Post →</button>
      <a href="/posts" class="btn btn-outline">Cancel</a>
    </div>

  </form>

</div>

<%- include("../partials/footer") %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
